{
    "image": "mcr.microsoft.com/devcontainers/rust:2-bookworm",
    "features": {
        "ghcr.io/devcontainers-community/features/llvm": {
            "version": "23"
        },
        "ghcr.io/devcontainers-extra/features/cmake:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/ninja-build.org:1": {}
    },
    "onCreateCommand": {
        "install mlir": "sudo apt-get update && sudo apt-get install -y libmlir-23-dev libmlir-23-dbgsym mlir-23-tools"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tombi-toml.tombi",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-mlir"
            ]
        }
    }
}
