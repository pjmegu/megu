    <Compile Include="Parser/Or.fs" />
    <Compile Include="Parser/Dyn.fs" />
    <Compile Include="Parser/Action.fs" />
    <Compile Include="Parser/Then.fs" />
    <Compile Include="Parser/Many.fs" />
    <Compile Include="Parser/Recover.fs" />
  </ItemGroup>

</Project>
